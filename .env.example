# NukePII — environment template.
# Copy to `.env` (or export in your shell) and fill in your own values.
# `.env` is git-ignored; this file contains placeholders only.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env

# --- Web server ---
# Bind address and port for `make run` / `python nukepii/web/app.py`.
NUKEPII_HOST=127.0.0.1
NUKEPII_PORT=5000

# Max upload size in megabytes (default 256).
NUKEPII_MAX_MB=256

# Set to 1 only if you explicitly need raw (unmasked) previews.
# Default (unset or 0) forces masked Safe Preview everywhere.
NUKEPII_ALLOW_RAW=0

# Set to 1 for the Flask debugger. NEVER enable in production.
NUKEPII_DEBUG=0

# --- Vault (reversible tokenization) ---
# Master key for vault encryption. Generate one per environment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the vault uses an ephemeral dev key (tokens do NOT survive
# restarts) and logs a warning.
NUKEPII_VAULT_KEY=your_vault_master_key_here

# HMAC salt namespace for vault token derivation (non-secret, but keep
# it stable per environment so tokens stay deterministic).
NUKEPII_VAULT_SALT=nukepii-vault-v1

# --- Optional NER model (Phase-2, off by default) ---
# Absolute path to an ONNX token-classification model. When unset (and
# onnxruntime missing), the engine runs regex+checksum only.
# NUKEPII_NER_MODEL=/models/minilm-pii.onnx
